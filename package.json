{
  "name": "syncbay",
  "version": "0.1.3",
  "private": true,
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev --webpack",
    "build": "node node_modules/prisma/build/index.js generate && node node_modules/next/dist/bin/next build --webpack",
    "vercel-build": "node scripts/vercel-build.mjs",
    "postinstall": "node node_modules/prisma/build/index.js generate || prisma generate",
    "start": "node node_modules/next/dist/bin/next start",
    "lint": "node node_modules/eslint/bin/eslint.js",
    "test": "node node_modules/tsx/dist/cli.mjs tests/e2e/run-all.ts",
    "test:tunnel": "node node_modules/tsx/dist/cli.mjs tests/verify-tunnel-ingress.ts",
    "test:fallback": "node node_modules/tsx/dist/cli.mjs tests/verify-runner-530-fallback.ts",
    "test:email": "node node_modules/tsx/dist/cli.mjs tests/verify-email-templates.ts",
    "test:edge": "node node_modules/tsx/dist/cli.mjs tests/verify-edge-registry.ts",
    "test:db": "node node_modules/tsx/dist/cli.mjs tests/verify-managed-db.ts",
    "test:terminal": "node node_modules/tsx/dist/cli.mjs tests/verify-terminal.ts",
    "test:terminal-stateless": "node node_modules/tsx/dist/cli.mjs tests/verify-terminal-stateless.ts",
    "test:domains": "node node_modules/tsx/dist/cli.mjs tests/verify-domains.ts",
    "test:observe": "node node_modules/tsx/dist/cli.mjs tests/verify-observability.ts",
    "test:deploy": "node node_modules/tsx/dist/cli.mjs tests/verify-deploy-lifecycle.ts",
    "test:billing": "node node_modules/tsx/dist/cli.mjs tests/verify-billing.ts",
    "test:r2": "node node_modules/tsx/dist/cli.mjs tests/verify-r2.ts",
    "test:devops": "node node_modules/tsx/dist/cli.mjs tests/verify-devops.ts",
    "test:query": "node node_modules/tsx/dist/cli.mjs tests/verify-query-studio.ts",
    "db:generate": "node node_modules/prisma/build/index.js generate",
    "db:migrate": "node node_modules/prisma/build/index.js migrate dev",
    "db:studio": "node node_modules/prisma/build/index.js studio",
    "db:format": "node node_modules/prisma/build/index.js format",
    "db:seed": "node prisma/seed.js",
    "typecheck": "tsc --noEmit",
    "knip": "knip"
  },
  "bin": {
    "syncbay": "./bin/syncbay.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@octokit/rest": "^22.0.1",
    "@prisma/client": "^5.22.0",
    "@react-email/components": "^1.0.12",
    "@stripe/react-stripe-js": "^7.0.1",
    "@stripe/stripe-js": "^10.2.1",
    "@tanstack/react-query": "^5.102.8",
    "@trpc/client": "^11.13.0",
    "@trpc/react-query": "^11.13.0",
    "@trpc/server": "^11.13.0",
    "@types/three": "^0.186.0",
    "bcryptjs": "^3.0.3",
    "ioredis": "^5.11.1",
    "mysql2": "^3.24.6",
    "next": "16.3.4",
    "next-auth": "^4.24.11",
    "pg": "^8.23.1",
    "prisma": "^5.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.28.1",
    "stripe": "^23.1.0",
    "superjson": "^2.2.6",
    "three": "^0.186.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "knip": "^6.44.1",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "allowScripts": {
    "prisma@5.22.0": true,
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true
  }
}
