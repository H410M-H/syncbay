{
  "name": "syncbay",
  "version": "0.1.3",
  "private": true,
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev --webpack",
    "build": "node node_modules/prisma/build/index.js generate && node node_modules/next/dist/bin/next build --webpack",
    "postinstall": "node node_modules/prisma/build/index.js generate || prisma generate",
    "start": "node node_modules/next/dist/bin/next start",
    "lint": "node node_modules/eslint/bin/eslint.js",
    "test": "node node_modules/tsx/dist/cli.mjs tests/e2e/run-all.ts",
    "test:tunnel": "node node_modules/tsx/dist/cli.mjs tests/verify-tunnel-ingress.ts",
    "db:generate": "node node_modules/prisma/build/index.js generate",
    "db:migrate": "node node_modules/prisma/build/index.js migrate dev",
    "db:studio": "node node_modules/prisma/build/index.js studio",
    "db:format": "node node_modules/prisma/build/index.js format",
    "db:seed": "node prisma/seed.js"
  },
  "bin": {
    "syncbay": "./bin/syncbay.js"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "^1.0.7",
    "@octokit/rest": "^22.0.1",
    "@prisma/client": "^5.22.0",
    "@react-email/components": "^1.0.12",
    "@tanstack/react-query": "^5.102.8",
    "@trpc/client": "^11.13.0",
    "@trpc/react-query": "^11.13.0",
    "@trpc/server": "^11.13.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/three": "^0.186.0",
    "bcryptjs": "^3.0.3",
    "next": "16.3.4",
    "next-auth": "^4.24.11",
    "pg": "^8.23.1",
    "prisma": "^5.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.28.1",
    "superjson": "^2.2.6",
    "three": "^0.186.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "allowScripts": {
    "prisma@5.22.0": true,
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true
  }
}
