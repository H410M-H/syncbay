// Syncbay — Control-Plane Database Schema
// PRD §6 — v0.1 | MSNS-DEV™
// This schema covers Syncbay's own metadata ONLY.
// Customer application data lives inside whatever the customer deploys.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── ENUMS ───────────────────────────────────────────────────────────────────

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum DeploymentStatus {
  QUEUED
  BUILDING
  DEPLOYING
  ACTIVE
  CRASHED
  SLEEPING
  FAILED
  CANCELLED
  SUPERSEDED
}

enum BuildStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum DomainStatus {
  PENDING
  VERIFYING
  ACTIVE
  FAILED
}

enum DatabaseProvider {
  POSTGRES
  REDIS
  MYSQL
}

enum ApiTokenScope {
  READ_ONLY
  DEPLOY_ONLY
  FULL_ACCESS
}

enum UsageResourceType {
  CPU_ACTIVE_SECONDS
  MEMORY_GIB_HOURS
  DISK_GB_HOURS
  EGRESS_GB
  DB_STORAGE_GB
  BUCKET_STORAGE_GB
}

enum InvoiceStatus {
  OPEN
  PAID
  PAST_DUE
  VOID
}

// ─── USER & AUTH ──────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  emailVerified DateTime?
  githubId      String?   @unique
  passwordHash  String?
  totpSecret    String?
  totpEnabled   Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  memberships WorkspaceMember[]
  apiTokens   ApiToken[]
  auditLogs   AuditLogEntry[]
  sessions    Session[]
  accounts    Account[]

  @@map("users")
}

model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String?
  refresh_token_expires_in Int?
  access_token             String?
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String?
  session_state            String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── WORKSPACES & TEAMS ───────────────────────────────────────────────────────

model Workspace {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  isPersonal       Boolean  @default(false)
  spendingCapCents   Int?
  stripeCustomerId   String?
  creditBalanceCents Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  members        WorkspaceMember[]
  projects       Project[]
  invites        WorkspaceInvite[]
  apiTokens      ApiToken[]
  auditLogs      AuditLogEntry[]
  usageRecords   UsageRecord[]
  invoices       Invoice[]
  paymentMethods PaymentMethod[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  joinedAt    DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@map("workspace_members")
}

model WorkspaceInvite {
  id          String        @id @default(cuid())
  workspaceId String
  email       String?
  role        WorkspaceRole @default(MEMBER)
  token       String        @unique @default(cuid())
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("workspace_invites")
}

// ─── PROJECTS & ENVIRONMENTS ──────────────────────────────────────────────────

model Project {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  description String?
  tags        String[]
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  environments Environment[]
  buckets      Bucket[]
  featureFlags FeatureFlag[]

  @@map("projects")
}

model Environment {
  id        String   @id @default(cuid())
  projectId String
  name      String
  isDefault Boolean  @default(false)
  isPrEnv   Boolean  @default(false)
  prNumber  Int?
  createdAt DateTime @default(now())

  project   Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  services  Service[]
  databases DatabaseInstance[]

  @@unique([projectId, name])
  @@map("environments")
}

// ─── SERVICES ─────────────────────────────────────────────────────────────────

model Service {
  id              String    @id @default(cuid())
  environmentId   String
  name            String
  sourceType      String // "github" | "docker" | "empty"
  repoUrl         String?
  branch          String?
  rootDir         String?
  dockerImage     String?
  buildCommand    String?
  startCommand    String?
  port            Int?
  instanceType    String    @default("lite") // Cloudflare Containers instance type
  scaleToZero     Boolean   @default(true)
  idleTimeoutSecs Int       @default(300)
  isPaused        Boolean   @default(false)
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  environment Environment           @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  builds      Build[]
  deployments Deployment[]
  domains     Domain[]
  variables   EnvironmentVariable[]
  volumes     Volume[]

  @@map("services")
}

// ─── BUILDS ───────────────────────────────────────────────────────────────────

model Build {
  id            String      @id @default(cuid())
  serviceId     String
  commitSha     String?
  commitMessage String?
  triggeredBy   String? // userId or "automatic"
  status        BuildStatus @default(QUEUED)
  startedAt     DateTime?
  completedAt   DateTime?
  durationMs    Int?
  imageRef      String? // Cloudflare Containers image reference
  createdAt     DateTime    @default(now())

  service     Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  deployments Deployment[]

  @@map("builds")
}

// ─── DEPLOYMENTS ──────────────────────────────────────────────────────────────

model Deployment {
  id               String           @id @default(cuid())
  serviceId        String
  buildId          String
  triggeredBy      String?
  status           DeploymentStatus @default(QUEUED)
  cfContainerId    String? // Cloudflare Containers instance ID
  healthCheckUrl   String?
  startedAt        DateTime?
  completedAt      DateTime?
  buildDurationMs  Int?
  deployDurationMs Int?
  createdAt        DateTime         @default(now())

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  build   Build   @relation(fields: [buildId], references: [id])

  @@map("deployments")
}

// ─── DOMAINS ──────────────────────────────────────────────────────────────────

model Domain {
  id              String       @id @default(cuid())
  serviceId       String
  hostname        String       @unique // DR-06: globally unique
  isGenerated     Boolean      @default(false)
  isWildcard      Boolean      @default(false)
  status          DomainStatus @default(PENDING)
  verificationTxt String?
  cfZoneId        String?
  cfRecordId      String?
  verifiedAt      DateTime?
  createdAt       DateTime     @default(now())

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@map("domains")
}

// ─── ENVIRONMENT VARIABLES ────────────────────────────────────────────────────

model EnvironmentVariable {
  id          String   @id @default(cuid())
  serviceId   String?
  workspaceId String? // for shared workspace variables (FR-VAR-03)
  key         String
  value       String // DR-03: encrypted at application layer before persistence
  isSecret    Boolean  @default(true)
  isReference Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  service Service? @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@map("environment_variables")
}

// ─── DATABASES ────────────────────────────────────────────────────────────────

model DatabaseInstance {
  id               String           @id @default(cuid())
  environmentId    String
  provider         DatabaseProvider @default(POSTGRES)
  name             String
  partnerDbId      String? // external managed-DB partner's ID
  connectionUrl    String // DR-03: encrypted
  region           String
  storageGb        Int              @default(1)
  backupRetainDays Int              @default(7)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  environment Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@map("database_instances")
}

// ─── VOLUMES & BUCKETS ────────────────────────────────────────────────────────

model Volume {
  id        String   @id @default(cuid())
  serviceId String
  name      String
  mountPath String
  sizeGb    Int      @default(1)
  createdAt DateTime @default(now())

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@map("volumes")
}

model Bucket {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  r2BucketRef String
  createdAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("buckets")
}

// ─── FEATURE FLAGS ────────────────────────────────────────────────────────────

model FeatureFlag {
  id             String   @id @default(cuid())
  projectId      String
  key            String
  isEnabled      Boolean  @default(false)
  rolloutPercent Int      @default(0)
  updatedAt      DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, key])
  @@map("feature_flags")
}

// ─── API TOKENS ───────────────────────────────────────────────────────────────

model ApiToken {
  id          String        @id @default(cuid())
  userId      String?
  workspaceId String
  name        String
  tokenHash   String        @unique
  scope       ApiTokenScope @default(READ_ONLY)
  lastUsedAt  DateTime?
  createdAt   DateTime      @default(now())
  revokedAt   DateTime?

  user      User?     @relation(fields: [userId], references: [id])
  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@map("api_tokens")
}

// ─── USAGE & BILLING ──────────────────────────────────────────────────────────

model UsageRecord {
  id           String            @id @default(cuid())
  serviceId    String
  workspaceId  String
  resourceType UsageResourceType
  quantity     Float
  periodStart  DateTime
  periodEnd    DateTime

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@index([serviceId, periodStart])
  @@map("usage_records")
}

model Invoice {
  id              String        @id @default(cuid())
  workspaceId     String
  stripeInvoiceId String?
  paymentMethodId String?
  periodStart     DateTime
  periodEnd       DateTime
  amountCents     Int
  infraCostCents  Int
  status          InvoiceStatus @default(OPEN)
  pdfUrl          String?
  paidAt          DateTime?
  createdAt       DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@map("invoices")
}

model PaymentMethod {
  id                    String    @id @default(cuid())
  workspaceId           String
  brand                 String    // "visa" | "mastercard" | "amex" | "discover"
  last4                 String    // e.g. "4242"
  expMonth              Int       // 1-12
  expYear               Int       // e.g. 2028
  cardholderName        String?
  isDefault             Boolean   @default(false)
  stripePaymentMethodId String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  workspace             Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("payment_methods")
}

// ─── AUDIT LOG ────────────────────────────────────────────────────────────────

model AuditLogEntry {
  id          String   @id @default(cuid())
  workspaceId String
  actorUserId String?
  action      String // e.g. "member.invited", "domain.verified", "service.deleted"
  metadata    Json?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  actor     User?     @relation(fields: [actorUserId], references: [id])

  @@map("audit_log_entries")
}
