# Copy to .env and fill in. Never commit the real .env.

# Public hostname Caddy serves (DNS A record -> this server's public IP, DNS-only/grey cloud).
RUNNER_DOMAIN=runner.syncbay.app
# Let's Encrypt account email (certificate expiry notices), or `internal` for a local test.
RUNNER_TLS=you@example.com

# Shared HMAC secret. Must equal RUNNER_SECRET in the Vercel project. Generate: openssl rand -hex 32
RUNNER_SECRET=
# Control plane the runner registers routes back to.
SYNCBAY_API_URL=https://syncbay.app

# Host written into managed-database connection URLs handed to services.
# Use this server's private VPC IP if the apps run here, or its public IP for external access.
RUNNER_DB_HOST=127.0.0.1
# Managed databases: docker (default) | native | mock
RUNNER_DB_MODE=docker
