# ═══════════════════════════════════════════════════════════════════════════════
# Syncbay environment configuration
#
# Copy to .env.local (Next.js) and fill in values. Placeholders only: never
# commit real secrets. Empty values are treated as "unset".
#
#   [required]          the app refuses to start in production without it
#   [required: feature] needed only when that feature is used
#   [optional]          has a safe default
#
# Server env is validated in src/lib/env.ts (validation is skipped during
# `next build`, so CI and Vercel builds work without secrets).
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Control-plane database (Prisma / PostgreSQL) ─────────────────────────────
# Syncbay's own metadata DB. Never share this cluster with customer databases.
# [required] Pooled connection used at runtime (e.g. PgBouncer / Neon pooler).
DATABASE_URL="postgresql://postgres:password@localhost:5432/syncbay_dev"
# [required] Direct (non-pooled) connection used by `prisma migrate`.
#            Locally this can be the same as DATABASE_URL.
DIRECT_URL="postgresql://postgres:password@localhost:5432/syncbay_dev"

# ─── App URLs ─────────────────────────────────────────────────────────────────
# [optional] Canonical base URL used by NextAuth. On Vercel it may be left unset;
#            the app then falls back to NEXT_PUBLIC_APP_URL, then https://$VERCEL_URL.
NEXTAUTH_URL="http://localhost:3000"
# [optional] Public base URL used in links and emails (invites, notifications).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# [optional] Base URL the edge proxy (src/proxy.ts) uses to reach its own
#            API (edge-resolve). Defaults to NEXTAUTH_URL, then http://127.0.0.1:$PORT.
INTERNAL_API_URL=""

# ─── NextAuth.js ──────────────────────────────────────────────────────────────
# [required] JWT / session encryption secret. Generate: openssl rand -base64 32
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# [required: Google sign-in] https://console.cloud.google.com/apis/credentials
# Authorized redirect URIs: see "OAuth callback URLs" in README.md
#   http://localhost:3000/api/auth/callback/google
#   https://syncbay.app/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── GitHub (OAuth app, webhooks, API) ────────────────────────────────────────
# [required: GitHub sign-in] https://github.com/settings/applications/new
# Callback URL: http://localhost:3000/api/auth/callback/github (dev)
#               https://syncbay.app/api/auth/callback/github (prod)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# [required: push / PR-preview deploys] Secret configured on the GitHub webhook.
GITHUB_WEBHOOK_SECRET="generate-with-openssl-rand-base64-32"
# [optional] Server-side token for PR statuses / comments when no user OAuth
#            token is available (GITHUB_PAT and GITHUB_ACCESS_TOKEN are aliases).
GITHUB_TOKEN=""

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# [optional] When unset, emails are logged to the console instead of sent.
RESEND_API_KEY=""
# [optional] Sender address. Default: Syncbay <no-reply@syncbay.app>
EMAIL_FROM="Syncbay <no-reply@syncbay.app>"

# ─── Runner (data plane) — control-plane side ─────────────────────────────────
# [optional] Driver: webhook | ssh | queue | local | mock
#            Default: webhook when RUNNER_URL is set, otherwise local.
RUNNER_DRIVER="local"
# [required: remote compute] Public URL of the runner daemon (e.g. via Cloudflare Tunnel).
RUNNER_URL=""
# [required: remote compute] Shared HMAC-SHA256 secret for X-Syncbay-Signature.
#            Must match the runner's RUNNER_SECRET. Generate: openssl rand -hex 32
RUNNER_SECRET=""
# [optional] "true" forces the in-process local driver.
RUNNER_FORCE_LOCAL="false"
# [optional] "true" disables the local fallback after a failed remote dispatch (e.g. HTTP 530).
RUNNER_FORCE_REMOTE="false"
# [optional] Allow falling back to the in-process local driver when the remote
#            runner is unreachable ("false" to disable).
RUNNER_FALLBACK_LOCAL="true"
# [required: RUNNER_DRIVER=ssh] Remote build host.
RUNNER_SSH_HOST=""
RUNNER_SSH_PORT="22"
RUNNER_SSH_USER="root"
RUNNER_SSH_KEY_PATH="~/.ssh/id_ed25519"

# ─── Runner daemon (set on the runner host, runner/) ──────────────────────────
# [optional] Listen port / interface.
RUNNER_PORT="8080"
RUNNER_HOST="0.0.0.0"
# [required: runner] Control-plane URL the runner registers routes back to.
SYNCBAY_API_URL="http://localhost:3000"
# [optional] Legacy aliases for RUNNER_SECRET (checked first: RUNNER_WEBHOOK_SECRET).
RUNNER_WEBHOOK_SECRET=""
SYNCBAY_WEBHOOK_SECRET=""
# [optional] "true" selects the DB-backed queue driver (same as RUNNER_DRIVER=queue).
RUNNER_QUEUE_MODE=""
# [optional] Host written into managed database connection URLs. Default: 127.0.0.1
#            (use host.docker.internal or the host IP when services run in Docker).
RUNNER_DB_HOST="127.0.0.1"
# [optional] PTY wrapper used for web-terminal sessions. Default: script
RUNNER_PTY_WRAPPER="script"

# ─── Edge route store (Upstash Redis) ─────────────────────────────────────────
# [optional, recommended in prod] Persistent L2 store for edge routes. When unset,
#            routes live in memory per instance and are re-resolved through the DB.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ─── Cloudflare (custom domains, DNS, tunnels) ────────────────────────────────
# [required: custom domains / tunnels] API token scopes: Zone:DNS:Edit,
#            SSL and Certificates:Edit, Account:Cloudflare Tunnel:Edit.
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ZONE_ID=""
# [required: named tunnel] Tunnel ID and connector token (`cloudflared tunnel token <id>`).
CLOUDFLARE_TUNNEL_ID=""
CLOUDFLARE_TUNNEL_TOKEN=""
# [optional] CNAME target for customer custom hostnames. Default: cname.syncbay.app
CLOUDFLARE_CNAME_TARGET="cname.syncbay.app"

# ─── Tunnel driver (runner host) ──────────────────────────────────────────────
# [optional] cloudflare | local | ssh. Default: cloudflare when a tunnel token is set, else local.
TUNNEL_DRIVER="local"
# [optional] Local origin the tunnel forwards traffic to. Default: http://127.0.0.1:3000
TUNNEL_INGRESS_URL="http://127.0.0.1:3000"
# [optional] Path to the cloudflared binary. Default: cloudflared on PATH.
CLOUDFLARED_BIN="cloudflared"
# [optional] Connector token alias for CLOUDFLARE_TUNNEL_TOKEN.
TUNNEL_TOKEN=""
# [optional] Config-file mode: ingress YAML written per deploy, then cloudflared restarts.
TUNNEL_CONFIG_FILE=""
TUNNEL_CREDENTIALS_FILE=""
# [optional] Command used by reloadTunnel() in local mode. Default: systemctl restart cloudflared
TUNNEL_RESTART_COMMAND=""

# ─── Syncbay CLI (bin/syncbay.js) ─────────────────────────────────────────────
# [optional] API token and default project for the `syncbay` CLI.
SYNCBAY_API_TOKEN=""
SYNCBAY_PROJECT=""

# ─── Object storage (Cloudflare R2) ───────────────────────────────────────────
# [required: managed buckets] R2 S3-compatible credentials.
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""

# ─── Managed databases ────────────────────────────────────────────────────────
# [required: managed customer DBs] API key for the database partner provider.
DATABASE_PARTNER_API_KEY=""

# ─── Cron ─────────────────────────────────────────────────────────────────────
# [required in prod] Bearer token for /api/cron/* (Vercel Cron sends it automatically
#            when set in the project). Generate: openssl rand -hex 32
CRON_SECRET=""

# ─── Runtime ──────────────────────────────────────────────────────────────────
# Set automatically by Next.js / Vercel; listed for reference only.
# NODE_ENV="development"
# VERCEL_URL / VERCEL_BRANCH_URL / VERCEL_PROJECT_PRODUCTION_URL are injected by
# Vercel and are trusted as OAuth redirect origins (src/lib/auth.ts).
